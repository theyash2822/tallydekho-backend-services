# TallyDekho Backend — Environment Variables
# Copy this file to .env and fill in your values
# DO NOT commit .env to git

# Server
PORT=3001
NODE_ENV=production

# JWT — access tokens are short-lived and server-backed; refresh handles the rest
JWT_SECRET=generate_with_openssl_rand_hex_32
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_TTL_MS=2592000000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/tallydekho

# CORS — allowed origins (comma separated)
ALLOWED_ORIGINS=http://localhost:5173,https://your-domain.com

# WhatsApp OTP (Cronberry WABA)
CRONBERRY_URL=https://crmapi.cronberry.com/api/v1/messages
CRONBERRY_TOKEN=your_cronberry_bearer_token_here
CRONBERRY_TEMPLATE=otp_international

# Internal API secret (for /ingest/complete-notify)
INTERNAL_SECRET=generate_a_random_secret_here

# Desktop version management
DESKTOP_VERSION=1.0.0
DESKTOP_MIN_VERSION=1.0.0

# Razorpay credit recharge (Owner)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# PUBLIC_API_BASE=https://api.tallydekho.com
