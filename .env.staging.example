# TallyDekho Backend — STAGING environment template
#
# Variable NAMES only. Never commit real values.
# Copy to .env on the staging host and fill in staging-only credentials.
#
# Staging runs PRODUCTION behaviour with a STAGING identity:
#   NODE_ENV=production  → production code paths (no dev shortcuts, no OTP echo,
#                          destructive CID migrations blocked on boot)
#   APP_ENV=staging      → environment identity, DB stamp, guards
#
# The backend refuses to boot if APP_ENV is production-like while
# NODE_ENV != production, and refuses to boot if this DATABASE_URL points at a
# database stamped for another environment (see src/db/deploymentIdentity.js).

# ─── Environment identity ─────────────────────────────────────────────────────
NODE_ENV=production
APP_ENV=staging
PORT=

# ─── Database — MUST be a dedicated staging database ──────────────────────────
# Separate host/database/credentials from production. Never reuse the production
# DATABASE_URL. After restoring a sanitized production snapshot, the first boot
# needs RESTAMP_DEPLOYMENT_ENV=1 to take ownership of the restored stamp.
DATABASE_URL=

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Staging MUST use its own JWT secret. Sharing the production secret would make
# staging-issued tokens valid in production.
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=
JWT_REFRESH_TTL_MS=
# Leave unset in staging: production-like behaviour rejects sessionless JWTs.
# ALLOW_LEGACY_JWT=

# ─── CORS — staging origins only ──────────────────────────────────────────────
ALLOWED_ORIGINS=

# ─── Internal service auth ────────────────────────────────────────────────────
INTERNAL_SECRET=

# ─── OTP / messaging — use sandbox or staging-only credentials ────────────────
# Real production messaging credentials must not be reachable from staging.
CRONBERRY_URL=
CRONBERRY_TOKEN=
CRONBERRY_TEMPLATE=
PROACTIVE_SMS_BASE_URL=
PROACTIVE_SMS_API_KEY=
PROACTIVE_SMS_SENDER_ID=
PROACTIVE_SMS_OTP_TEMPLATE_ID=
PROACTIVE_SMS_REMINDER_TEMPLATE_ID=

# ─── Email ────────────────────────────────────────────────────────────────────
AWS_SES_REGION=
AWS_SES_ACCESS_KEY=
AWS_SES_SECRET_KEY=
AWS_SES_FROM_EMAIL=

# ─── Payments — staging/test keys only, never live keys ───────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── Desktop version feed ─────────────────────────────────────────────────────
DESKTOP_VERSION=
DESKTOP_MIN_VERSION=

# ─── Public base URL advertised to clients ────────────────────────────────────
PUBLIC_API_BASE=

# ─── Destructive migrations — MUST stay unset ─────────────────────────────────
# The Company Identity cutover is an operator-supervised step run via
# scripts/cid-guid-unique-cutover.mjs, never on application boot.
# CID_ALLOW_DESTRUCTIVE_MIGRATION=
