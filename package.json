{
  "name": "td-backend",
  "version": "1.0.0",
  "description": "TallyDekho Backend — self-hosted server for Tally Prime sync",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test:unit": "RBAC_UNIT_ONLY=1 node --import dotenv/config --test \"src/__tests__/*.test.js\"",
    "test:rbac": "RBAC_INTEGRATION=1 node --import dotenv/config --test --test-concurrency=1 \"src/__tests__/rbac/*.test.js\"",
    "test": "npm run test:unit && npm run test:rbac",
    "test:ci": "npm test",
    "verify:legacy-columns": "node scripts/verify-rbac-legacy-column-removal.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.1042.0",
    "@xenova/transformers": "^2.17.2",
    "axios": "^1.13.6",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^9.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "expo-server-sdk": "^6.1.0",
    "express": "^4.18.3",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "node-cron": "^4.2.1",
    "node-fetch": "^3.3.2",
    "nodemailer": "^8.0.7",
    "pg": "^8.20.0",
    "socket.io": "^4.7.5",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.3"
  }
}
